#!/usr/bin/env sh
# bend — launcher for the tracker-neutral issue command.
#
# What: runs bend/cli.ts with node.
#
# Why: bend is written in TypeScript, like the plugin it sits beside, and
# node (22.6 and later) runs TypeScript files directly. This small script is
# what goes on the PATH, so the command is plain `bend`.
#
# Design notes:
# - Plain sh. The house default for scripts is Babashka, but on this machine
#   the name `bb` is the BB app's command, so a `bb` script would run the
#   wrong program.
# - It finds its own real location first, so it works when it is reached
#   through a symlink (for example from ~/.local/bin).
#
# Gotchas:
# - Needs node 22.6 or later. --no-warnings hides node's notice that running
#   TypeScript directly is still marked experimental.

self=$0
# Follow symlinks until the real file is reached.
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)

exec node --experimental-strip-types --no-warnings "$here/../bend/cli.ts" "$@"
